<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FleckDef ParentName="RimKetsu_FleckBase_Thrown">
    <defName>RimKetsu_Fleck_MoonSlashTrail</defName>
    <graphicData>
      <texPath>Things/Mote/LongSparkThrown</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.5, 0.55, 1.0, 0.85)</color>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.05</solidTime>
    <fadeOutTime>0.25</fadeOutTime>
  </FleckDef>

  <ThingDef ParentName="RimKetsu_MoteAttachedBase">
    <defName>RimKetsu_Mote_MoonBreathingAura</defName>
    <mote>
      <fadeInTime>0.5</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.5</fadeOutTime>
      <needsMaintenance>True</needsMaintenance>
    </mote>
    <graphicData>
      <graphicClass>Graphic_PawnBodySilhouette</graphicClass>
      <color>(0.3, 0.35, 0.85, 0.75)</color>
      <shaderType>MoteMultiplyAddScroll</shaderType>
      <texPath>Things/Mote/Transparent</texPath>
      <shaderParameters>
        <_MultiplyTexA>/Things/Mote/Cloudy_B</_MultiplyTexA>
        <_MultiplyTexB>/Things/Mote/Cloudy_C</_MultiplyTexB>
        <_DetailTex>/Things/Mote/Speckles</_DetailTex>
        <_detailIntensity>1.2</_detailIntensity>
        <_texAScale>0.38</_texAScale>
        <_texBScale>0.3</_texBScale>
        <_DetailScale>1.15</_DetailScale>
        <_texAScrollSpeed>(0.03, 0.12, 0)</_texAScrollSpeed>
        <_texBScrollSpeed>(0.1, 0.02, 0)</_texBScrollSpeed>
        <_detailScrollSpeed>(0.09, 0.09, 0)</_detailScrollSpeed>
      </shaderParameters>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="RimKetsu_MoteBase">
    <defName>RimKetsu_Mote_MoonCrescentSlash</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.04</fadeInTime>
      <solidTime>0.12</solidTime>
      <fadeOutTime>0.5</fadeOutTime>
      <growthRate>5.5</growthRate>
    </mote>
    <graphicData>
      <texPath>Things/Mote/RadiationDistortion_A</texPath>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <color>(0.25, 0.3, 0.95, 0.9)</color>
      <shaderType>MoteMultiplyAddCircularGrayscale</shaderType>
      <shaderParameters>
        <_MultiplyTex>/Things/Mote/RadiationDistortion_B</_MultiplyTex>
        <_texAScale>0.28</_texAScale>
        <_texBScale>0.28</_texBScale>
        <_texAScrollSpeed>2.2</_texAScrollSpeed>
        <_texBScrollSpeed>-1.4</_texBScrollSpeed>
        <_Intensity>12</_Intensity>
      </shaderParameters>
      <drawSize>(3.5, 3.5)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="RimKetsu_MoteBase">
    <defName>RimKetsu_Mote_MoonGlowHit</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <mote>
      <fadeInTime>0.03</fadeInTime>
      <solidTime>0.1</solidTime>
      <fadeOutTime>0.4</fadeOutTime>
      <growthRate>4.5</growthRate>
    </mote>
    <graphicData>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.55, 0.6, 1.0, 0.85)</color>
      <drawSize>1.3</drawSize>
    </graphicData>
  </ThingDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_MoonBreathingAmbient</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_MoonSlashTrail</fleckDef>
        <chancePerTick>0.06</chancePerTick>
        <positionRadius>0.35</positionRadius>
        <speed>0.4~1.0</speed>
        <scale>0.1~0.22</scale>
        <angle>45~135</angle>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_DemonEssencePuff</fleckDef>
        <chancePerTick>0.025</chancePerTick>
        <positionRadius>0.25</positionRadius>
        <speed>0.1~0.3</speed>
        <scale>0.4~0.75</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_Exhaustion_Moon</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_DemonEssencePuff</fleckDef>
        <chancePerTick>0.03</chancePerTick>
        <positionRadius>0.25</positionRadius>
        <speed>0.05~0.18</speed>
        <scale>0.3~0.55</scale>
        <color>(0.2, 0.15, 0.5, 0.35)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_EnchantAmbient_Moon</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_MoonSlashTrail</fleckDef>
        <chancePerTick>0.20</chancePerTick>
        <positionRadius>0.4</positionRadius>
        <speed>0.6~1.5</speed>
        <scale>0.16~0.36</scale>
        <angle>45~135</angle>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_DemonEssencePuff</fleckDef>
        <chancePerTick>0.10</chancePerTick>
        <positionRadius>0.3</positionRadius>
        <speed>0.2~0.5</speed>
        <scale>0.6~1.1</scale>
        <color>(0.3, 0.35, 0.85, 0.9)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_MoonBreathingHit</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>RimKetsu_Mote_MoonCrescentSlash</moteDef>
        <burstCount>1~2</burstCount>
        <scale>0.7~1.1</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>RimKetsu_Mote_MoonGlowHit</moteDef>
        <burstCount>1~1</burstCount>
        <scale>0.9~1.4</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.3</positionRadius>
        <fleckDef>AirPuff</fleckDef>
        <burstCount>4~6</burstCount>
        <speed>0.4~0.9</speed>
        <scale>0.5~0.9</scale>
        <color>(0.3, 0.35, 0.9, 0.65)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
    <offsetTowardsTarget>0.25~0.25</offsetTowardsTarget>
    <positionRadius>0.1</positionRadius>
  </EffecterDef>

</Defs>
