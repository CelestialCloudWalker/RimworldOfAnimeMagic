        <burstCount>5~8</burstCount>
        <speed>0.5~1.2</speed>
        <scale>1.2~2.0</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
    <offsetTowardsTarget>0.25~0.25</offsetTowardsTarget>
    <positionRadius>0.15</positionRadius>
  </EffecterDef>

</Defs>
