    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_StoneDust</fleckDef>
        <chancePerTick>0.04</chancePerTick>
        <positionRadius>0.35</positionRadius>
        <speed>0.1~0.3</speed>
        <scale>0.4~0.8</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_Exhaustion_Stone</defName>
    <children>
      <li>
