<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <FleckDef ParentName="RimKetsu_FleckBase_Thrown">
    <defName>RimKetsu_Fleck_StoneDust</defName>
    <graphicData>
      <texPath>Things/Mote/DustPuff</texPath>
      <shaderType>Transparent</shaderType>
      <color>(0.6, 0.5, 0.38, 0.6)</color>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.06</fadeInTime>
    <solidTime>0.4</solidTime>
    <fadeOutTime>1.4</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="RimKetsu_FleckBase_Thrown">
    <defName>RimKetsu_Fleck_StoneChip</defName>
    <graphicData>
      <texPath>Things/Mote/Stone</texPath>
      <shaderType>Cutout</shaderType>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>Projectile</altitudeLayer>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.5</solidTime>
    <fadeOutTime>0.2</fadeOutTime>
  </FleckDef>


  <ThingDef ParentName="RimKetsu_MoteAttachedBase">
    <defName>RimKetsu_Mote_StoneBreathingAura</defName>
    <mote>
      <fadeInTime>0.6</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.6</fadeOutTime>
      <needsMaintenance>True</needsMaintenance>
    </mote>
    <graphicData>
      <graphicClass>Graphic_PawnBodySilhouette</graphicClass>
      <color>(0.65, 0.55, 0.4, 0.7)</color>
      <shaderType>MoteMultiplyAddScroll</shaderType>
      <texPath>Things/Mote/Transparent</texPath>
      <shaderParameters>
        <_MultiplyTexA>/Things/Mote/Cloudy_B</_MultiplyTexA>
        <_MultiplyTexB>/Things/Mote/Cloudy_C</_MultiplyTexB>
        <_DetailTex>/Things/Mote/Speckles</_DetailTex>
        <_detailIntensity>1.3</_detailIntensity>
        <_texAScale>0.5</_texAScale>
        <_texBScale>0.4</_texBScale>
        <_DetailScale>1.2</_DetailScale>
        <_texAScrollSpeed>(0, 0.08, 0)</_texAScrollSpeed>
        <_texBScrollSpeed>(0.06, 0, 0)</_texBScrollSpeed>
        <_detailScrollSpeed>(0.05, 0.05, 0)</_detailScrollSpeed>
      </shaderParameters>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="RimKetsu_MoteBase">
    <defName>RimKetsu_Mote_StoneGroundCrack</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>Filth</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <mote>
      <fadeInTime>0.3</fadeInTime>
      <solidTime>3.5</solidTime>
      <fadeOutTime>1.5</fadeOutTime>
      <growthRate>0</growthRate>
    </mote>
    <graphicData>
      <texPath>Things/Mote/GroundCracks/GroundCrackHuge</texPath>
      <shaderType>Mote</shaderType>
      <renderInstanced>false</renderInstanced>
      <graphicClass>Graphic_Mote</graphicClass>
      <color>(0.5, 0.4, 0.3, 0.85)</color>
      <drawSize>(3.0, 3.0)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="RimKetsu_MoteBase">
    <defName>RimKetsu_Mote_StoneDebrisBit</defName>
    <thingClass>MoteThrown</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.03</fadeInTime>
      <fadeOutTime>0.15</fadeOutTime>
      <solidTime>0.6</solidTime>
      <archHeight>0.6</archHeight>
      <archDuration>0.5</archDuration>
      <speedPerTime>-3</speedPerTime>
    </mote>
    <graphicData>
      <texPath>Things/Mote/Stone</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>0.35</drawSize>
    </graphicData>
  </ThingDef>

  <EffecterDef>
