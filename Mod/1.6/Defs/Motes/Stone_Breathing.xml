        <fleckDef>RimKetsu_Fleck_StoneDust</fleckDef>
        <chancePerTick>0.03</chancePerTick>
        <positionRadius>0.25</positionRadius>
        <speed>0.05~0.15</speed>
        <scale>0.3~0.55</scale>
