        <color>(0.5, 0.4, 0.3, 0.6)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_StoneBreathingHit</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>RimKetsu_Mote_StoneGroundCrack</moteDef>
        <burstCount>1~1</burstCount>
        <scale>0.8~1.4</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.1</positionRadius>
        <moteDef>RimKetsu_Mote_StoneDebrisBit</moteDef>
        <burstCount>6~10</burstCount>
        <speed>3.0~6.0</speed>
