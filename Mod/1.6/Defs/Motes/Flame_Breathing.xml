        <_MultiplyTex>/Things/Mote/RadiationDistortion_B</_MultiplyTex>
        <_texAScale>0.3</_texAScale>
        <_texBScale>0.3</_texBScale>
        <_texAScrollSpeed>2.5</_texAScrollSpeed>
        <_texBScrollSpeed>-1.5</_texBScrollSpeed>
        <_Intensity>13</_Intensity>
      </shaderParameters>
      <drawSize>(2.0, 2.0)</drawSize>
