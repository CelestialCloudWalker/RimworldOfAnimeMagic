        <_texAScrollSpeed>(0, 0.25, 0)</_texAScrollSpeed>
        <_texBScrollSpeed>(0.2, 0, 0)</_texBScrollSpeed>
        <_detailScrollSpeed>(0.2, 0.2, 0)</_detailScrollSpeed>
