<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FleckDef ParentName="RimKetsu_FleckBase_Static">
    <defName>RimKetsu_Fleck_SoundBoomFlash</defName>
    <graphicData>
      <texPath>Things/Mote/ExplosionFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.6, 0.1, 0.9, 0.8)</color>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <solidTime>0.04</solidTime>
    <fadeOutTime>0.12</fadeOutTime>
  </FleckDef>

  <FleckDef ParentName="RimKetsu_FleckBase_Thrown">
    <defName>RimKetsu_Fleck_SoundVibrationPuff</defName>
    <graphicData>
      <texPath>Things/Mote/MetaPuff</texPath>
      <shaderType>Transparent</shaderType>
      <color>(0.55, 0.08, 0.85, 0.45)</color>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.1</solidTime>
    <fadeOutTime>0.8</fadeOutTime>
  </FleckDef>

  <ThingDef ParentName="RimKetsu_MoteAttachedBase">
    <defName>RimKetsu_Mote_SoundBreathingAura</defName>
    <mote>
      <fadeInTime>0.4</fadeInTime>
      <solidTime>999999</solidTime>
      <fadeOutTime>0.4</fadeOutTime>
      <needsMaintenance>True</needsMaintenance>
    </mote>
    <graphicData>
      <graphicClass>Graphic_PawnBodySilhouette</graphicClass>
      <color>(0.6, 0.1, 0.9, 0.7)</color>
      <shaderType>MoteMultiplyAddScroll</shaderType>
      <texPath>Things/Mote/Transparent</texPath>
      <shaderParameters>
        <_MultiplyTexA>/Things/Mote/Cloudy_B</_MultiplyTexA>
        <_MultiplyTexB>/Things/Mote/Cloudy_C</_MultiplyTexB>
        <_DetailTex>/Things/Mote/Speckles</_DetailTex>
        <_detailIntensity>1.4</_detailIntensity>
        <_texAScale>0.4</_texAScale>
        <_texBScale>0.32</_texBScale>
        <_DetailScale>1.2</_DetailScale>
        <_texAScrollSpeed>(0.05, 0.2, 0)</_texAScrollSpeed>
        <_texBScrollSpeed>(0.15, 0.05, 0)</_texBScrollSpeed>
        <_detailScrollSpeed>(0.18, 0.18, 0)</_detailScrollSpeed>
      </shaderParameters>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="RimKetsu_MoteBase">
    <defName>RimKetsu_Mote_SonicBoomRing</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.02</fadeInTime>
      <solidTime>0.02</solidTime>
      <fadeOutTime>0.4</fadeOutTime>
      <growthRate>18.0</growthRate>
    </mote>
    <graphicData>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <shaderType>MotePsychicWarmupNeuroquake</shaderType>
      <texPath>Things/Mote/MoteHellfireCannon_HeatWaveDistortion</texPath>
      <shaderParameters>
        <_distortionIntensity>0.4</_distortionIntensity>
        <_brightnessMultiplier>1.5</_brightnessMultiplier>
        <_distortionTint>(0.05, 0.0, 0.1, 0)</_distortionTint>
        <_pulseSpeed>3</_pulseSpeed>
      </shaderParameters>
      <drawSize>2</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="RimKetsu_MoteBase">
    <defName>RimKetsu_Mote_SoundShockFlash</defName>
    <thingClass>MoteAttached</thingClass>
    <altitudeLayer>MoteOverheadLow</altitudeLayer>
    <mote>
      <fadeInTime>0.03</fadeInTime>
      <solidTime>0.08</solidTime>
      <fadeOutTime>0.35</fadeOutTime>
      <growthRate>7.0</growthRate>
    </mote>
    <graphicData>
      <texPath>Things/Mote/BrightFlash</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(0.65, 0.15, 0.95, 0.8)</color>
      <drawSize>1.6</drawSize>
    </graphicData>
  </ThingDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_SoundBreathingAmbient</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_SoundVibrationPuff</fleckDef>
        <chancePerTick>0.06</chancePerTick>
        <positionRadius>0.4</positionRadius>
        <speed>0.2~0.6</speed>
        <scale>0.5~1.0</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_Exhaustion_Sound</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_SoundVibrationPuff</fleckDef>
        <chancePerTick>0.03</chancePerTick>
        <positionRadius>0.25</positionRadius>
        <speed>0.05~0.2</speed>
        <scale>0.3~0.55</scale>
        <color>(0.35, 0.05, 0.5, 0.35)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_EnchantAmbient_Sound</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_SoundVibrationPuff</fleckDef>
        <chancePerTick>0.20</chancePerTick>
        <positionRadius>0.45</positionRadius>
        <speed>0.3~0.9</speed>
        <scale>0.8~1.5</scale>
        <color>(0.6, 0.1, 0.9, 0.9)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
        <fleckDef>RimKetsu_Fleck_SoundBoomFlash</fleckDef>
        <chancePerTick>0.04</chancePerTick>
        <positionRadius>0.2</positionRadius>
        <scale>0.5~1.1</scale>
        <color>(0.6, 0.1, 0.9, 0.8)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

  <EffecterDef>
    <defName>RimKetsu_Effecter_SoundBreathingHit</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>RimKetsu_Mote_SonicBoomRing</moteDef>
        <burstCount>1~1</burstCount>
        <scale>1.0~1.5</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <moteDef>RimKetsu_Mote_SoundShockFlash</moteDef>
        <burstCount>1~2</burstCount>
        <scale>0.8~1.3</scale>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.4</positionRadius>
        <fleckDef>AirPuff</fleckDef>
        <burstCount>8~12</burstCount>
        <speed>0.8~1.6</speed>
        <scale>0.7~1.2</scale>
        <color>(0.6, 0.1, 0.9, 0.55)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>ExplosionFlash</fleckDef>
        <burstCount>1~1</burstCount>
        <scale>2.5~3.5</scale>
        <color>(0.65, 0.15, 0.95, 0.6)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
    <offsetTowardsTarget>0.25~0.25</offsetTowardsTarget>
    <positionRadius>0.1</positionRadius>
  </EffecterDef>

</Defs>
