<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <TraitDef>
    <defName>InnerFire</defName>
    <commonality>0</commonality>
    <forcedPassions>
      <li>Cooking</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>inner fire</label>
        <description>[PAWN_nameDef] runs hot — literally. Cold that grounds others [PAWN_pronoun] barely notices; ovens and forges feel like home. [PAWN_possessive] appetite is the price: [PAWN_pronoun] eats more than [PAWN_possessive] share, and never apologises for it.</description>
        <degree>1</degree>
        <statOffsets>
          <ComfyTemperatureMin>-25</ComfyTemperatureMin>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
          <CookSpeed>0.4</CookSpeed>
          <SmeltingSpeed>0.3</SmeltingSpeed>
        </statOffsets>
        <skillGains>
          <Cooking>4</Cooking>
          <Crafting>2</Crafting>
        </skillGains>
      </li>
    </degreeDatas>
  </TraitDef>


  <TraitDef>
    <defName>BurningPassion</defName>
    <commonality>0</commonality>
    <forcedPassions>
      <li>Crafting</li>
      <li>Artistic</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>burning passion</label>
        <description>[PAWN_nameDef] does nothing halfway. Creative work absorbs [PAWN_objective] completely — the quality shows, and so does the cost. [PAWN_pronoun] needs to decompress more than most, and skips it less gracefully than most.</description>
        <degree>1</degree>
        <statOffsets>
          <WorkSpeedGlobal>0.15</WorkSpeedGlobal>
        </statOffsets>
        <skillGains>
          <Crafting>3</Crafting>
          <Artistic>3</Artistic>
        </skillGains>
