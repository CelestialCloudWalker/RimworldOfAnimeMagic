  <TraitDef>
    <defName>BlazingSpirit</defName>
    <commonality>0</commonality>
    <forcedPassions>
      <li>Social</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>blazing spirit</label>
        <description>[PAWN_nameDef] doesn't really do despair. [PAWN_pronoun] leads, lifts, and pushes forward, and others tend to follow whether they planned to or not. The catch is that [PAWN_pronoun] needs to keep moving — idle time hits [PAWN_objective] harder than it hits most.</description>
