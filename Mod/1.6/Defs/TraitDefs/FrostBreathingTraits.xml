<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <TraitDef>
    <defName>IceInVeins</defName>
    <commonality>0</commonality>
    <conflictingTraits>
      <li>Neurotic</li>
    </conflictingTraits>
    <degreeDatas>
      <li>
        <label>ice in veins</label>
        <description>[PAWN_nameDef] moves deliberately, thinks deliberately, and feels pain as a fact rather than an emergency. Cold that stops others [PAWN_pronoun] doesn't notice. The tradeoff is everything runs at the same speed — work, movement, reaction. Measured. Exact. Slow.</description>
        <degree>1</degree>
        <statOffsets>
          <ComfyTemperatureMin>-50</ComfyTemperatureMin>
          <ComfyTemperatureMax>35</ComfyTemperatureMax>
          <PainShockThreshold>0.4</PainShockThreshold>
          <WorkSpeedGlobal>-0.2</WorkSpeedGlobal>
          <MoveSpeed>-0.3</MoveSpeed>
          <MentalBreakThreshold>-0.2</MentalBreakThreshold>
        </statOffsets>
        <skillGains>
          <Intellectual>2</Intellectual>
          <Crafting>2</Crafting>
        </skillGains>
        <marketValueFactorOffset>0.03</marketValueFactorOffset>
      </li>
    </degreeDatas>
  </TraitDef>


  <TraitDef>
    <defName>FrozenFocus</defName>
    <commonality>0</commonality>
    <forcedPassions>
      <li>Intellectual</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>frozen focus</label>
        <description>[PAWN_nameDef] doesn't get rattled. [PAWN_possessive] mind stays clear under pressure that makes others stumble — useful in research, in crisis, in anything that requires thinking when it's hard to think. [PAWN_pronoun] is harder to reach emotionally, which people notice eventually.</description>
        <degree>1</degree>
        <statOffsets>
          <ResearchSpeed>0.4</ResearchSpeed>
          <MentalBreakThreshold>-0.25</MentalBreakThreshold>
          <SocialImpact>-0.3</SocialImpact>
          <MeditationFocusGain>0.4</MeditationFocusGain>
          <ComfyTemperatureMin>-40</ComfyTemperatureMin>
        </statOffsets>
        <skillGains>
          <Intellectual>5</Intellectual>
          <Social>-2</Social>
        </skillGains>
        <marketValueFactorOffset>0.08</marketValueFactorOffset>
      </li>
    </degreeDatas>
  </TraitDef>


  <TraitDef>
    <defName>GlacialEndurance</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>glacial endurance</label>
        <description>[PAWN_nameDef] runs on less. Less food, less sleep, less urgency. [PAWN_pronoun] moves slowly and shoots with the patience of someone who has already decided where the shot is going. Nothing about [PAWN_objective] is quick. Everything about [PAWN_objective] is thorough.</description>
        <degree>1</degree>
        <statOffsets>
          <RestRateMultiplier>0.7</RestRateMultiplier>
          <PainShockThreshold>0.3</PainShockThreshold>
          <MoveSpeed>-0.4</MoveSpeed>
          <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
          <WorkSpeedGlobal>-0.15</WorkSpeedGlobal>
        </statOffsets>
        <skillGains>
          <Shooting>3</Shooting>
          <Crafting>3</Crafting>
        </skillGains>
        <marketValueFactorOffset>0.06</marketValueFactorOffset>
      </li>
    </degreeDatas>
  </TraitDef>


  <TraitDef>
    <defName>WintersHeart</defName>
    <commonality>0</commonality>
    <forcedPassions>
      <li>Melee</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>winter's heart</label>
        <description>[PAWN_nameDef] is built for cold. [PAWN_pronoun] fights better when the air hurts to breathe and most people are focused on staying warm. Heat is the enemy — [PAWN_pronoun] struggles more than most when temperatures climb.</description>
        <degree>1</degree>
        <statOffsets>
          <ComfyTemperatureMin>-60</ComfyTemperatureMin>
          <ComfyTemperatureMax>15</ComfyTemperatureMax>
          <MeleeHitChance>0.06</MeleeHitChance>
          <MentalBreakThreshold>-0.05</MentalBreakThreshold>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.2</MeleeDamageFactor>
        </statFactors>
        <skillGains>
          <Melee>4</Melee>
          <Crafting>2</Crafting>
        </skillGains>
        <marketValueFactorOffset>0.02</marketValueFactorOffset>
      </li>
    </degreeDatas>
  </TraitDef>


  <TraitDef>
    <defName>CryogenicHealing</defName>
    <commonality>0</commonality>
    <forcedPassions>
      <li>Medicine</li>
    </forcedPassions>
    <degreeDatas>
      <li>
        <label>cryogenic healing</label>
        <description>[PAWN_nameDef] heals slowly and completely. [PAWN_pronoun] doesn't rush recovery — [PAWN_possessive] body handles infection like cold handles bacteria, steadily and thoroughly. [PAWN_possessive] surgical work shares the same quality: unhurried, precise, reliable.</description>
        <degree>1</degree>
        <statOffsets>
          <ImmunityGainSpeed>0.5</ImmunityGainSpeed>
          <SurgerySuccessChanceFactor>0.3</SurgerySuccessChanceFactor>
          <MedicalTendSpeed>0.25</MedicalTendSpeed>
          <ComfyTemperatureMin>-45</ComfyTemperatureMin>
        </statOffsets>
        <skillGains>
          <Medicine>5</Medicine>
          <Intellectual>2</Intellectual>
        </skillGains>
        <marketValueFactorOffset>0.15</marketValueFactorOffset>
      </li>
    </degreeDatas>
  </TraitDef>


  <TraitDef>
    <defName>AbsoluteZero</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>absolute zero</label>
        <description>[PAWN_nameDef] exists at a temperature that shouldn't be survivable. [PAWN_pronoun] is functional in cold that kills others, immune to food contamination, and largely indifferent to psychic pressure. [PAWN_possessive] company is about as warm as [PAWN_objective] sounds — most people find it hard to get close.</description>
        <degree>1</degree>
        <statOffsets>
          <ComfyTemperatureMin>-80</ComfyTemperatureMin>
          <ComfyTemperatureMax>40</ComfyTemperatureMax>
          <SocialImpact>-0.5</SocialImpact>
          <MeleeHitChance>0.04</MeleeHitChance>
          <FoodPoisonChance>-1.0</FoodPoisonChance>
          <PsychicSensitivity>-0.3</PsychicSensitivity>
        </statOffsets>
        <skillGains>
          <Melee>3</Melee>
          <Cooking>3</Cooking>
          <Social>-4</Social>
        </skillGains>
        <marketValueFactorOffset>0.05</marketValueFactorOffset>
      </li>
    </degreeDatas>
  </TraitDef>

</Defs>
