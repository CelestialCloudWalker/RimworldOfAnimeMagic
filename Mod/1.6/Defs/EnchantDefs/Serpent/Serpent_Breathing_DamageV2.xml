<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <DamageDef>
    <defName>Serpent_Breathing_Damage</defName>
    <label>serpent twist</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <hasForcefulImpact>true</hasForcefulImpact>
    <makesBlood>true</makesBlood>
    <canInterruptJobs>true</canInterruptJobs>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    <harmsHealth>true</harmsHealth>
    <deathMessage>{0}'s body was twisted apart by serpentine force.</deathMessage>
    <damageEffecter>AnimeArsenal_BeastHit2</damageEffecter>
    <defaultStoppingPower>0.4</defaultStoppingPower>
    <stabChanceOfForcedInternal>0.15</stabChanceOfForcedInternal>
    <hediff>TwistOfSerpent</hediff>
    <hediffSkin>TwistOfSerpent</hediffSkin>
    <hediffSolid>Crack</hediffSolid>
    <armorCategory>Sharp</armorCategory>
    <impactSoundType>Slice</impactSoundType>
    <minDamageToFragment>13</minDamageToFragment>
    <defaultDamage>8</defaultDamage>
    <defaultArmorPenetration>0.18</defaultArmorPenetration>
    <overkillPctToDestroyPart>0.3</overkillPctToDestroyPart>
    <additionalHediffs>
      <li>
        <hediff>BloodLoss</hediff>
        <severityPerDamageDealt>0.008</severityPerDamageDealt>
      </li>
    </additionalHediffs>
    <buildingDamageFactor>0.5</buildingDamageFactor>
    <plantDamageFactor>1.0</plantDamageFactor>
    <corpseDamageFactor>1.3</corpseDamageFactor>
    <canUseDeflectMetalEffect>true</canUseDeflectMetalEffect>
  </DamageDef>

  <HediffDef ParentName="InjuryBase">
    <defName>TwistOfSerpent</defName>
    <label>serpent twist</label>
    <labelNoun>a serpent twist</labelNoun>
    <description>A twisting injury that tears and contorts tissue along unnatural angles. Internal damage compounds the surface wound.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>bandaged</labelTendedWell>
        <labelTendedWellInner>sutured</labelTendedWellInner>
        <labelSolidTendedWell>set</labelSolidTendedWell>
        <severityPerDayTended>-0.50</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Infecter">
        <infectionChance>0.30</infectionChance>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>serpent twist scar</permanentLabel>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.1</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.06</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.14</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.12</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.65</minSeverity>
        <painOffset>0.10</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.24</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.08</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <injuryProps>
      <painPerSeverity>0.045</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
      <bleedRate>0.06</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>twisted off</destroyedLabel>
      <destroyedOutLabel>twisted apart</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

</Defs>
