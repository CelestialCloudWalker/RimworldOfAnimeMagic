<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <DamageDef>
    <defName>Forest_Breathing_Damage</defName>
    <label>forest strike</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <hasForcefulImpact>true</hasForcefulImpact>
    <makesBlood>true</makesBlood>
    <canInterruptJobs>true</canInterruptJobs>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    <harmsHealth>true</harmsHealth>
    <deathMessage>{0} was crushed to pieces by an overwhelming force of nature.</deathMessage>
    <damageEffecter>AnimeArsenal_BeastHit2</damageEffecter>
    <defaultStoppingPower>0.6</defaultStoppingPower>
    <hediff>MajestyOfForest</hediff>
    <hediffSkin>MajestyOfForest</hediffSkin>
    <hediffSolid>Crack</hediffSolid>
    <armorCategory>Blunt</armorCategory>
    <impactSoundType>Blunt</impactSoundType>
    <minDamageToFragment>20</minDamageToFragment>
    <defaultDamage>8</defaultDamage>
    <defaultArmorPenetration>0.1</defaultArmorPenetration>
    <overkillPctToDestroyPart>0.4</overkillPctToDestroyPart>
    <additionalHediffs>
      <li>
        <hediff>Wisteria_Poisoning</hediff>
        <severityPerDamageDealt>0.06</severityPerDamageDealt>
      </li>
    </additionalHediffs>
    <buildingDamageFactor>0.6</buildingDamageFactor>
    <plantDamageFactor>1.8</plantDamageFactor>
    <corpseDamageFactor>1.2</corpseDamageFactor>
    <canUseDeflectMetalEffect>true</canUseDeflectMetalEffect>
  </DamageDef>

  <HediffDef ParentName="InjuryBase">
    <defName>MajestyOfForest</defName>
    <label>forest strike</label>
    <labelNoun>a forest strike</labelNoun>
    <description>A crushing blow from an overwhelming force of nature. Heavy tissue damage and deep bleeding.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>bandaged</labelTendedWell>
        <labelTendedWellInner>sutured</labelTendedWellInner>
        <labelSolidTendedWell>set</labelSolidTendedWell>
        <severityPerDayTended>-0.55</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Infecter">
        <infectionChance>0.25</infectionChance>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>forest strike scar</permanentLabel>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.1</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.12</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.08</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <painOffset>0.08</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.22</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.06</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <injuryProps>
      <painPerSeverity>0.06</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00825</averagePainPerSeverityPermanent>
      <bleedRate>0.09</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>crushed off</destroyedLabel>
      <destroyedOutLabel>crushed apart</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

</Defs>
