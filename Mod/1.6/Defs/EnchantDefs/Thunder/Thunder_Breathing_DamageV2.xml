<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <DamageDef>
    <defName>Thunder_Breathing_Damage</defName>
    <label>lightning strike</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <hasForcefulImpact>true</hasForcefulImpact>
    <makesBlood>false</makesBlood>
    <canInterruptJobs>true</canInterruptJobs>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    <harmsHealth>true</harmsHealth>
    <deathMessage>{0} was killed by a surge of lightning that stopped their heart cold.</deathMessage>
    <damageEffecter>AnimeArsenal_BeastHit2</damageEffecter>
    <defaultStoppingPower>0.6</defaultStoppingPower>
    <stabChanceOfForcedInternal>0.10</stabChanceOfForcedInternal>
    <hediff>BoltsOfThunder</hediff>
    <hediffSkin>BoltsOfThunder</hediffSkin>
    <hediffSolid>Crack</hediffSolid>
    <armorCategory>Sharp</armorCategory>
    <impactSoundType>Slice</impactSoundType>
    <minDamageToFragment>11</minDamageToFragment>
    <defaultDamage>11</defaultDamage>
    <defaultArmorPenetration>0.22</defaultArmorPenetration>
    <overkillPctToDestroyPart>0.2</overkillPctToDestroyPart>
    <additionalHediffs>
      <li>
        <hediff>Hypothermia</hediff>
        <severityPerDamageDealt>0.03</severityPerDamageDealt>
      </li>
    </additionalHediffs>
    <buildingDamageFactor>0.8</buildingDamageFactor>
    <plantDamageFactor>1.8</plantDamageFactor>
    <corpseDamageFactor>1.0</corpseDamageFactor>
    <canUseDeflectMetalEffect>false</canUseDeflectMetalEffect>
  </DamageDef>

  <HediffDef ParentName="InjuryBase">
    <defName>BoltsOfThunder</defName>
    <label>lightning strike</label>
    <labelNoun>a lightning strike</labelNoun>
    <description>Tissue seared by electric current moving faster than thought. Severe nerve damage and muscle seizure compound the burn.</description>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>bandaged</labelTendedWell>
        <labelTendedWellInner>sutured</labelTendedWellInner>
        <labelSolidTendedWell>set</labelSolidTendedWell>
        <severityPerDayTended>-0.50</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Infecter">
        <infectionChance>0.20</infectionChance>
      </li>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>lightning strike scar</permanentLabel>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.1</minSeverity>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.08</offset>
          </li>
        </capMods>
        <statOffsets>
          <ComfyTemperatureMin>3</ComfyTemperatureMin>
          <ComfyTemperatureMax>-2</ComfyTemperatureMax>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.18</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.08</offset>
          </li>
        </capMods>
        <statOffsets>
          <ComfyTemperatureMin>8</ComfyTemperatureMin>
          <ComfyTemperatureMax>-5</ComfyTemperatureMax>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <painOffset>0.12</painOffset>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.30</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.18</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
        <statOffsets>
          <ComfyTemperatureMin>15</ComfyTemperatureMin>
          <ComfyTemperatureMax>-10</ComfyTemperatureMax>
        </statOffsets>
      </li>
    </stages>
    <injuryProps>
      <painPerSeverity>0.055</painPerSeverity>
      <averagePainPerSeverityPermanent>0.00725</averagePainPerSeverityPermanent>
      <bleedRate>0.06</bleedRate>
      <canMerge>true</canMerge>
      <destroyedLabel>electrocuted off</destroyedLabel>
      <destroyedOutLabel>electrocuted</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

</Defs>
