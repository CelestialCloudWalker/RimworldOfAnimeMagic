<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>BloodPoison_HediffTwo</defName>
    <label>blood demon poison</label>
    <description>Gyutaro's toxic blood courses through the victim's veins. Without mastery of controlled breathing, the poison spreads rapidly and is invariably fatal.</description>
    <displayWound>false</displayWound>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.1, 0.1)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <isBad>true</isBad>
    <initialSeverity>0.05</initialSeverity>
    <stages>
      <li>
        <label>trace</label>
        <minSeverity>0.01</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>spreading</label>
        <minSeverity>0.20</minSeverity>
        <painOffset>0.10</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>severe</label>
        <minSeverity>0.40</minSeverity>
        <painOffset>0.20</painOffset>
        <vomitMtbDays>5</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>critical</label>
        <minSeverity>0.60</minSeverity>
        <painOffset>0.35</painOffset>
        <vomitMtbDays>2</vomitMtbDays>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>WanderConfused</mentalState>
            <mtbDays>10</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <label>fatal</label>
        <minSeverity>0.80</minSeverity>
        <painOffset>0.55</painOffset>
        <vomitMtbDays>1</vomitMtbDays>
        <lifeThreatening>true</lifeThreatening>
        <deathMtbDays>3</deathMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.35</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.30</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>0.35</postFactor>
          </li>
          <li>
            <capacity>Talking</capacity>
            <postFactor>0.30</postFactor>
          </li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>WanderConfused</mentalState>
            <mtbDays>3</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>1.0</severityPerDay>
      </li>
    </comps>
  </HediffDef>

</Defs>
