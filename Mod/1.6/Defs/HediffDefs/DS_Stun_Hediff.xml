<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>DS_Stun_Hediff</defName>
    <label>stunned</label>
    <description>Momentarily unable to move, struck by a powerful shockwave.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.9, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
      <li Class="AnimeArsenal.HediffCompProperties_ApplyHediffOnRemoved">
        <hediffToApply>AA_WisteriaWound</hediffToApply>
        <onlyIfGenePresent>BloodDemonArt</onlyIfGenePresent>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.0</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
