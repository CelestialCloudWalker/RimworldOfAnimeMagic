<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>DemonHunger_Mild</defName>
    <label>mild demon hunger</label>
    <description>This demon is getting hungry and starting to weaken.</description>
    <defaultLabelColor>(180, 180, 0)</defaultLabelColor>
    <isBad>true</isBad>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DemonHunger_Severe</defName>
    <label>severe demon hunger</label>
    <description>This demon is desperately hungry and significantly weakened.</description>
    <defaultLabelColor>(255, 140, 0)</defaultLabelColor>
    <isBad>true</isBad>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DemonHunger_Critical</defName>
    <label>critical demon hunger</label>
    <description>This demon is on the verge of losing all control to starvation.</description>
    <defaultLabelColor>(255, 0, 0)</defaultLabelColor>
    <isBad>true</isBad>
    <makesSickThought>false</makesSickThought>
    <tendable>false</tendable>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.30</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
