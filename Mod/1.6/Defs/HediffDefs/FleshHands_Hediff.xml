<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>DS_FleshHands_Hediff</defName>
    <label>flesh hands</label>
    <description>Writhing flesh hands erupt from the ground and seize the victim, crushing and holding them completely immobile.</description>
    <displayWound>false</displayWound>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 0.3, 0.2)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <initialSeverity>1.0</initialSeverity>
    <stages>
      <li>
        <label>seized</label>
        <minSeverity>0.01</minSeverity>
        <painOffset>0.30</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.0</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-4.0</severityPerDay>
      </li>
    </comps>
  </HediffDef>

</Defs>
