    <label>Fourth Form: Lamentation, Punishment</label>
    <description>The user erupts forward in a blinding frost-dash, carving a frozen line through every enemy in their path. Each soul caught in the rush is stopped cold — shivering, stunned, unable to act as punishment is delivered upon them.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>500</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayOrder>415</displayOrder>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>25</resourceCost>
    <baseExperienceGain>16</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>14</range>
      <warmupTime>0.3</warmupTime>
      <noiseRadius>3</noiseRadius>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_AbilityForwardDash">
        <avoidEnemies>false</avoidEnemies>
        <castEffecter>AnimeArsenal_FrostHit</castEffecter>
        <landEffecter>AnimeArsenal_FrostHit</landEffecter>
      </li>
      <li Class="AnimeArsenal.CompProperties_AbilityDashPathDamage">
        <damageDef>Frost_Breathing_Damage</damageDef>
        <damageAmount>
          <min>25</min>
          <max>30</max>
        </damageAmount>
        <armourPen>
          <min>0.15</min>
          <max>0.15</max>
        </armourPen>
        <width>2</width>
        <stunTicksOnHit>80</stunTicksOnHit>
        <hediffOnHit>FrostBreathing_ChillingSting</hediffOnHit>
        <hediffSeverity>0.35</hediffSeverity>
        <hitEffecter>AnimeArsenal_FrostHit</hitEffecter>
        <canHitFriendly>false</canHitFriendly>
      </li>
    </comps>

    <levels>

