<Defs>

  <HediffDef>
    <defName>FrostBreathing_ChillingSting</defName>
    <label>Chilling Sting</label>
    <description>Frost has been driven deep into the flesh by a piercing strike. The cold spreads from the wound outward, stiffening muscle and numbing nerve — the more hits land, the deeper the freeze bites.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>0.1</initialSeverity>

    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.0</severityPerDay>
      </li>
    </comps>

    <stages>
      <li>
        <label>pricked</label>
        <minSeverity>0.0</minSeverity>
        <statFactors>
          <MoveSpeed>0.95</MoveSpeed>
        </statFactors>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>

      <li>
        <label>frost bitten</label>
        <minSeverity>0.25</minSeverity>
        <statFactors>
          <MoveSpeed>0.80</MoveSpeed>
        </statFactors>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>

      <li>
        <label>deep freeze</label>
        <minSeverity>0.50</minSeverity>
        <statFactors>
          <MoveSpeed>0.60</MoveSpeed>
        </statFactors>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.28</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.28</offset>
          </li>
        </capMods>
      </li>

      <li>
        <label>frozen through</label>
