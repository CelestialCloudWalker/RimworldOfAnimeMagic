<Defs>

  <HediffDef>
    <defName>DS_BloodMarked_Hediff</defName>
    <label>blood marked</label>
    <description>Demon blood has been flicked onto this pawn. The blood pulses with energy, ready to detonate.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.15, 0.25)</defaultLabelColor>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
