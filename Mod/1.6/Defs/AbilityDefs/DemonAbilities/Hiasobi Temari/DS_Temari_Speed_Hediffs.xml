  <HediffDef>
    <defName>DS_TemariBall_Lifespan_L1</defName>
    <label>temari ball lifespan</label>
    <description>This temari ball will dissolve after its duration ends.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.5, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="EMF.HediffCompProperties_DamagePerInterval">
        <damageAmount>7</damageAmount>
        <intervalTicks>150</intervalTicks>
        <damageDef>Blunt</damageDef>
      </li>
    </comps>
  </HediffDef>

