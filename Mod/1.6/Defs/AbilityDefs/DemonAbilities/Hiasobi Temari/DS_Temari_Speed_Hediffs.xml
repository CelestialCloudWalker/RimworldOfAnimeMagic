<Defs>

  <HediffDef>
    <defName>DS_SpeedAugmentation_L1</defName>
    <label>speed augmentation</label>
    <description>Blood demon art floods the body with explosive speed. Every motion becomes faster, sharper, harder to predict.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 0.85, 1.0)</defaultLabelColor>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <statOffsets>
          <MoveSpeed>1.4</MoveSpeed>
          <MeleeDodgeChance>0.15</MeleeDodgeChance>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.10</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

