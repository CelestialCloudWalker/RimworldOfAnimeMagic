  <ThingDef ParentName="BaseFleshbeast">
    <defName>DS_SusamaruBall_Entity</defName>
    <label>temari ball</label>
    <description>A supernaturally animated temari ball left behind by Susamaru's Blood Demon Art. It spins with lethal momentum, crushing anything it rolls into while radiating destructive force in all directions.</description>
    <graphicData>
      <texPath>Things/Ball</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9, 0.9)</drawSize>
    </graphicData>
    <statBases>
      <MoveSpeed>2.8</MoveSpeed>
      <ToxicResistance>1.0</ToxicResistance>
    </statBases>
    <race>
      <body>Fingerspike</body>
      <baseBodySize>0.6</baseBodySize>
      <lifeExpectancy>1</lifeExpectancy>
      <hasGenders>false</hasGenders>
      <bloodDef>Filth_Blood</bloodDef>
      <trainability>None</trainability>
      <deathAction>
        <workerClass>DeathActionWorker_SmallExplosion</workerClass>
      </deathAction>
      <lifeStageAges>
        <li>
          <def>EntityFullyFormed</def>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>temari slam</label>
        <labelNoLocation>ball</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <soundMeleeHit>Pawn_Fleshbeast_Attack_Blunt</soundMeleeHit>
      </li>
    </tools>
  </ThingDef>

  <PawnKindDef>
