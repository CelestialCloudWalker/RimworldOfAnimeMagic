      <drawSize>(0.5, 0.5)</drawSize>
    </graphicData>
    <statBases>
      <MoveSpeed>3.5</MoveSpeed>
      <MarketValue>0</MarketValue>
    </statBases>
    <race>
      <intelligence>Animal</intelligence>
      <baseBodySize>0.5</baseBodySize>
