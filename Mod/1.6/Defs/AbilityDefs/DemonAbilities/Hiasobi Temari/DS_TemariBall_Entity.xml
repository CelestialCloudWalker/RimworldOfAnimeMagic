<Defs>

  <EMF.LevelingResourceAbilityDef>
    <defName>DS_TemariBall_Kick</defName>
    <label>Temari Kick Loop</label>
    <category>BloodDemonArts_AbilityCaterogry</category>
    <description>The Temari Ball loops a kick attack on nearby enemies.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>false</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <resourceDef>BloodDemonArts_Resource</resourceDef>
    <resourceCost>0</resourceCost>
    <baseExperienceGain>0</baseExperienceGain>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>1</range>
      <warmupTime>0</warmupTime>
      <soundCast>Pawn_Melee_Punch_HitPawn</soundCast>
    </verbProperties>
    <comps>
      <li Class="AnimeArsenal.CompProperties_DamageInRect">
        <damageAmount>7</damageAmount>
        <damageType>Blunt</damageType>
        <rectWidth>4</rectWidth>
      </li>
    </comps>
    <levels>
      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>7 Blunt AoE kick. Loops every 600 ticks.</description>
      </li>
    </levels>
  </EMF.LevelingResourceAbilityDef>

  <PawnKindDef>
