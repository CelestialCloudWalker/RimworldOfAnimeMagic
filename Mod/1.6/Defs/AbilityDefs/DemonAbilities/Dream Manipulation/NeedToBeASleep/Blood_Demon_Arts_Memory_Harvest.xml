<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <EMF.LevelingResourceAbilityDef>
    <defName>Blood_Demon_Arts_Memory_Harvest</defName>
    <label>Blood Demon Arts: Memory Harvest</label>
    <category>BloodDemonArts_AbilityCaterogry</category>
    <description>A blood demon art that dives into sleeping targets' dreams to extract information.</description>
    <iconPath>UI/Abilities/DemonSleepAbility4</iconPath>
    <displayOrder>212</displayOrder>
    <aiCanUse>true</aiCanUse>
    <resourceDef>BloodDemonArts_Resource</resourceDef>
    <resourceCost>20</resourceCost>
    <baseExperienceGain>12</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>3</range>
      <warmupTime>3.0</warmupTime>
      <soundCast>PsycastPsychicEffect</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_AbilityEffect_DreamManipulation">
        <dreamEffectType>MemoryExtraction</dreamEffectType>
        <effectSeverity>0.25</effectSeverity>
        <memoryExtractionHediff>MemoryConfusion</memoryExtractionHediff>
        <showMessage>true</showMessage>
      </li>
    </comps>

    <levels>
      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>Extracts memories from sleeping target. Applies MemoryConfusion (-10% consciousness, -15% talking). Range 3.</description>
      </li>

      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>55</experienceRequired>
        <resourceCostMultiplier>1.10</resourceCostMultiplier>
        <description>Deeper extraction. effectSeverity 0.35. Range 4.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_AbilityEffect_DreamManipulation">
            <dreamEffectType>MemoryExtraction</dreamEffectType>
            <effectSeverity>0.35</effectSeverity>
            <memoryExtractionHediff>MemoryConfusion</memoryExtractionHediff>
            <showMessage>true</showMessage>
          </li>
        </levelComps>
      </li>

      <li>
        <labelSuffix> (Level 3)</labelSuffix>
        <experienceRequired>120</experienceRequired>
        <resourceCostMultiplier>1.20</resourceCostMultiplier>
        <description>Deep memory extraction. Applies MemoryConfusion_L3 (-18% consciousness, -25% talking, -10% manipulation). Range 5.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_AbilityEffect_DreamManipulation">
            <dreamEffectType>MemoryExtraction</dreamEffectType>
            <effectSeverity>0.45</effectSeverity>
            <memoryExtractionHediff>MemoryConfusion_L3</memoryExtractionHediff>
            <showMessage>true</showMessage>
          </li>
        </levelComps>
      </li>

      <li>
        <labelSuffix> (Level 4)</labelSuffix>
        <experienceRequired>220</experienceRequired>
        <resourceCostMultiplier>1.35</resourceCostMultiplier>
        <description>effectSeverity 0.55. MemoryConfusion_L3. Range 5.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_AbilityEffect_DreamManipulation">
            <dreamEffectType>MemoryExtraction</dreamEffectType>
            <effectSeverity>0.55</effectSeverity>
            <memoryExtractionHediff>MemoryConfusion_L3</memoryExtractionHediff>
            <showMessage>true</showMessage>
          </li>
        </levelComps>
      </li>

      <li>
        <labelSuffix> (Level 5)</labelSuffix>
        <experienceRequired>350</experienceRequired>
        <resourceCostMultiplier>1.45</resourceCostMultiplier>
        <description>Total extraction. Applies MemoryConfusion_L5 (-25% consciousness, -35% talking, -20% manipulation, -10% moving). Range 6.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_AbilityEffect_DreamManipulation">
            <dreamEffectType>MemoryExtraction</dreamEffectType>
            <effectSeverity>0.63</effectSeverity>
            <memoryExtractionHediff>MemoryConfusion_L5</memoryExtractionHediff>
            <showMessage>true</showMessage>
          </li>
        </levelComps>
      </li>

      <li>
        <labelSuffix> (Level 6)</labelSuffix>
        <experienceRequired>520</experienceRequired>
        <resourceCostMultiplier>1.60</resourceCostMultiplier>
        <description>Perfected. Maximum memory extraction. MemoryConfusion_L5 applied. effectSeverity 0.70. Range 7. Max Level.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_AbilityEffect_DreamManipulation">
            <dreamEffectType>MemoryExtraction</dreamEffectType>
            <effectSeverity>0.70</effectSeverity>
            <memoryExtractionHediff>MemoryConfusion_L5</memoryExtractionHediff>
            <showMessage>true</showMessage>
          </li>
        </levelComps>
      </li>
    </levels>
  </EMF.LevelingResourceAbilityDef>
</Defs>
