<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>DS_ConversionTrauma</defName>
    <label>conversion trauma</label>
    <description>The mind has been forcibly reshaped. The victim struggles to process what they have become, leaving them psychologically shattered and barely functional.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.1, 0.6)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.05</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.0</minSeverity>
        <label>fading</label>
        <painOffset>0.02</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>moderate</label>
        <painOffset>0.08</painOffset>
        <mentalBreakMtbDays>8</mentalBreakMtbDays>
        <statOffsets>
          <WorkSpeedGlobal>-0.25</WorkSpeedGlobal>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>severe</label>
        <painOffset>0.15</painOffset>
        <mentalBreakMtbDays>4</mentalBreakMtbDays>
        <statOffsets>
          <WorkSpeedGlobal>-0.50</WorkSpeedGlobal>
          <MeleeDamageFactor>-0.20</MeleeDamageFactor>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.30</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>

    </stages>
  </HediffDef>

  <HediffDef>
