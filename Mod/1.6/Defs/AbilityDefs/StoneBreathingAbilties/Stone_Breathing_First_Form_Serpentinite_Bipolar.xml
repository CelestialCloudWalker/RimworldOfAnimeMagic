<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <EMF.LevelingResourceAbilityDef>
    <defName>Stone_Breathing_Strike</defName>
    <label>Stone Breathing: First Form: Serpentinite Bipolar</label>
    <description>壱ノ型　蛇紋岩・双極 — The user hurls themselves at the target, drilling through their body with rotating momentum. Targets vital organs.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>20</resourceCost>
    <baseExperienceGain>25</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>10</range>
      <warmupTime>0.8</warmupTime>
      <noiseRadius>6</noiseRadius>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_DashVitalStrike">
        <dashSpeed>2.0</dashSpeed>
        <damageType>Stone_Breathing_Damage</damageType>
        <initialStrikeDamage>18</initialStrikeDamage>
        <initialStrikeArmorPen>0.35</initialStrikeArmorPen>
        <targetVitalOrgans>true</targetVitalOrgans>
        <vitalOrganDamage>12</vitalOrganDamage>
        <vitalOrganArmorPen>0.5</vitalOrganArmorPen>
        <vitalOrganDamageType>Stone_Breathing_Damage</vitalOrganDamageType>
        <vitalStrikeBaseChance>0.55</vitalStrikeBaseChance>
        <vitalStrikeMinChance>0.15</vitalStrikeMinChance>
        <vitalStrikeMaxChance>0.85</vitalStrikeMaxChance>
        <scaleChanceByMeleeSkill>true</scaleChanceByMeleeSkill>
        <stunDuration>60</stunDuration>
        <missMessage>{INSTIGATOR}'s drill strike failed to find the core.</missMessage>
        <castEffecter>AnimeArsenal_StoneHit2</castEffecter>
        <impactEffecter>AnimeArsenal_StoneHit2</impactEffecter>
      </li>
    </comps>

    <levels>
      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>Drill through a target. Chance to strike vital organs.</description>
      </li>
      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>180</experienceRequired>
        <resourceCostMultiplier>1.3</resourceCostMultiplier>
        <rangeMultiplier>1.1</rangeMultiplier>
        <description>Drill strike strengthened. Vital organ hit chance improved.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_DashVitalStrike">
            <dashSpeed>2.0</dashSpeed>
            <damageType>Stone_Breathing_Damage</damageType>
            <initialStrikeDamage>23</initialStrikeDamage>
            <initialStrikeArmorPen>0.35</initialStrikeArmorPen>
            <targetVitalOrgans>true</targetVitalOrgans>
            <vitalOrganDamage>16</vitalOrganDamage>
            <vitalOrganArmorPen>0.5</vitalOrganArmorPen>
            <vitalOrganDamageType>Stone_Breathing_Damage</vitalOrganDamageType>
            <vitalStrikeBaseChance>0.65</vitalStrikeBaseChance>
            <vitalStrikeMinChance>0.15</vitalStrikeMinChance>
            <vitalStrikeMaxChance>0.90</vitalStrikeMaxChance>
            <scaleChanceByMeleeSkill>true</scaleChanceByMeleeSkill>
            <stunDuration>80</stunDuration>
            <missMessage>{INSTIGATOR}'s drill strike failed to find the core.</missMessage>
            <castEffecter>AnimeArsenal_StoneHit2</castEffecter>
            <impactEffecter>AnimeArsenal_StoneHit2</impactEffecter>
          </li>
        </levelComps>
      </li>
      <li>
        <labelSuffix> (Level 3)</labelSuffix>
        <experienceRequired>400</experienceRequired>
        <resourceCostMultiplier>1.6</resourceCostMultiplier>
        <rangeMultiplier>1.25</rangeMultiplier>
        <cooldownMultiplier>0.9</cooldownMultiplier>
        <description>Perfected drill momentum. Stun duration increased.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_DashVitalStrike">
            <dashSpeed>2.5</dashSpeed>
            <damageType>Stone_Breathing_Damage</damageType>
            <initialStrikeDamage>29</initialStrikeDamage>
            <initialStrikeArmorPen>0.4</initialStrikeArmorPen>
            <targetVitalOrgans>true</targetVitalOrgans>
            <vitalOrganDamage>20</vitalOrganDamage>
            <vitalOrganArmorPen>0.6</vitalOrganArmorPen>
            <vitalOrganDamageType>Stone_Breathing_Damage</vitalOrganDamageType>
            <vitalStrikeBaseChance>0.72</vitalStrikeBaseChance>
            <vitalStrikeMinChance>0.20</vitalStrikeMinChance>
            <vitalStrikeMaxChance>0.92</vitalStrikeMaxChance>
            <scaleChanceByMeleeSkill>true</scaleChanceByMeleeSkill>
            <stunDuration>120</stunDuration>
            <effectRadius>1.5</effectRadius>
            <missMessage>{INSTIGATOR}'s drill strike failed to find the core.</missMessage>
            <castEffecter>AnimeArsenal_StoneHit2</castEffecter>
            <impactEffecter>AnimeArsenal_StoneHit2</impactEffecter>
          </li>
        </levelComps>
      </li>
    </levels>
  </EMF.LevelingResourceAbilityDef>
</Defs>
