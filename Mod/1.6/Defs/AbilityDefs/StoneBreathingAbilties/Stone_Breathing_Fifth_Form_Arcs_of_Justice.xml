<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <EMF.LevelingResourceAbilityDef>
    <defName>Stone_Breathing_Strike_Fifth</defName>
    <label>Stone Breathing: Fifth Form: Arcs of Justice</label>
    <description>伍ノ型　瓦輪刑部 — A devastating two-stage barrage: the axe arcs forward first while the flail follows from the opposite trajectory, slamming into targets from behind with brutal force.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>960</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>32</resourceCost>
    <baseExperienceGain>35</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>14</range>
      <warmupTime>1.4</warmupTime>
      <noiseRadius>10</noiseRadius>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_WintryIcicles">
        <radius>5</radius>
        <icicleCount>10</icicleCount>
        <maxTargetsHit>5</maxTargetsHit>
        <damageAmount>14</damageAmount>
        <damageDef>Stone_Breathing_Damage</damageDef>
        <armorPen>0.3</armorPen>
        <icicleEffecter>AnimeArsenal_StoneHit2</icicleEffecter>
      </li>
    </comps>

    <levels>
      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>Two-stage arc barrage. Hits up to 5 targets in the impact zone.</description>
      </li>
      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>260</experienceRequired>
        <resourceCostMultiplier>1.4</resourceCostMultiplier>
        <rangeMultiplier>1.15</rangeMultiplier>
        <description>Barrage radius and target count increased.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_WintryIcicles">
            <radius>6</radius>
            <icicleCount>12</icicleCount>
            <maxTargetsHit>6</maxTargetsHit>
            <damageAmount>18</damageAmount>
            <damageDef>Stone_Breathing_Damage</damageDef>
            <armorPen>0.32</armorPen>
            <icicleEffecter>AnimeArsenal_StoneHit2</icicleEffecter>
          </li>
        </levelComps>
      </li>
      <li>
        <labelSuffix> (Level 3)</labelSuffix>
        <experienceRequired>520</experienceRequired>
        <resourceCostMultiplier>1.8</resourceCostMultiplier>
        <rangeMultiplier>1.3</rangeMultiplier>
        <cooldownMultiplier>0.85</cooldownMultiplier>
        <description>Justice delivered in full. Maximum targets, maximum impact.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_WintryIcicles">
            <radius>7</radius>
            <icicleCount>14</icicleCount>
            <maxTargetsHit>8</maxTargetsHit>
            <damageAmount>23</damageAmount>
            <damageDef>Stone_Breathing_Damage</damageDef>
            <armorPen>0.38</armorPen>
            <icicleEffecter>AnimeArsenal_StoneHit2</icicleEffecter>
          </li>
        </levelComps>
      </li>
    </levels>
  </EMF.LevelingResourceAbilityDef>

</Defs>
