<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef>
    <defName>WindForm8_GaleHazard_LOne</defName>
    <label>gale zone</label>
    <description>A howling column of wind left by the Primary Gale Slash. Standing in it is dangerous.</description>
    <thingClass>Verse.ThingWithComps</thingClass>
    <category>Ethereal</category>
    <useHitPoints>false</useHitPoints>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Animations/1024BLUR</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>3.5</drawSize>
      <color>(180, 255, 180)</color>
    </graphicData>
    <comps>
      <li Class="AnimeArsenal.CompProperties_GaleHazard">
        <durationTicks>120</durationTicks>
        <radius>2.0</radius>
        <damagePerTick>4</damagePerTick>
        <damageDef>Wind_Breathing_Damage</damageDef>
        <armorPen>0.20</armorPen>
        <tickInterval>15</tickInterval>
        <onlyAffectHostiles>true</onlyAffectHostiles>
        <hazardEffecter>AnimeArsenal_WindHitK</hazardEffecter>
      </li>
    </comps>
  </ThingDef>

