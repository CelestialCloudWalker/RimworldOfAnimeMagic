<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <EMF.LevelingResourceAbilityDef>
    <defName>LoveBreathing_ThirdForm_CatloveShower</defName>
    <label>Third Form: Catlove Shower</label>
    <description>Mitsuri leaps into the air and unleashes a rapid shower of arcing blade slashes in every direction — striking enemies at range while deflecting incoming attacks mid-flight. Graceful and lethal, like a cat shaking rain from its fur.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>520</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayOrder>120</displayOrder>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>30</resourceCost>
    <baseExperienceGain>18</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>18</range>
      <warmupTime>0.5</warmupTime>
      <noiseRadius>3</noiseRadius>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_AbilityFanProjectile">
        <projectileDef>LoveBreathing_CatloveSlash_Projectile_LOne</projectileDef>
        <projectileCount>5</projectileCount>
        <spreadAngle>60</spreadAngle>
      </li>
      <li Class="AnimeArsenal.CompProperties_DeflectProjectiles">
        <radius>4</radius>
        <TicksActive>300</TicksActive>
        <MaxShotsToReflect>6</MaxShotsToReflect>
        <effecterDef>AnimeArsenal_Deflect</effecterDef>
        <hediffDef>AnimeArsenal_DeflectionField</hediffDef>
      </li>
    </comps>

    <levels>

      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>Leaps and fires 5 arching slashes in a wide fan. Deflects up to 6 incoming shots during the form. Ranged threat at mid distance.</description>
        <cumulativeEffects>false</cumulativeEffects>
      </li>

      <li>
        <labelSuffix> (Level 2)</labelSuffix>
