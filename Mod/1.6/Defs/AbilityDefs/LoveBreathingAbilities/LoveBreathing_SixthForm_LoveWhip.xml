        <experienceRequired>0</experienceRequired>
        <description>A fast whip-crack slash at range. 18 damage, moderate armor penetration. Low cooldown — use it constantly.</description>
        <cumulativeEffects>false</cumulativeEffects>
      </li>

      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>120</experienceRequired>
        <resourceCostMultiplier>1.0</resourceCostMultiplier>
        <cooldownMultiplier>0.94</cooldownMultiplier>
        <description>22 damage. Slightly faster. Penetrates armor better.</description>
        <cumulativeEffects>false</cumulativeEffects>
        <levelComps>
          <li Class="CompProperties_AbilityLaunchProjectile">
            <projectileDef>LoveBreathing_LoveWhip_Projectile_LTwo</projectileDef>
