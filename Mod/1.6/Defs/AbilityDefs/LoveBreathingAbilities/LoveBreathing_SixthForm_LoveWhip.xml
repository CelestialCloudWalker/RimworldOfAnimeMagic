<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <EMF.LevelingResourceAbilityDef>
    <defName>LoveBreathing_SixthForm_LoveWhip</defName>
    <label>Sixth Form: Cat-Legged Winds of Love Whip</label>
    <description>A razor-precise whip crack of love breathing energy — a single pink-green line that snaps to the target faster than the eye can follow. No arc, no spread. Pure speed and penetration. The most economical technique in the style, meant to be used constantly between heavier forms.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>90</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayOrder>140</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>15</resourceCost>
    <baseExperienceGain>10</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>22</range>
      <warmupTime>0.25</warmupTime>
      <noiseRadius>2</noiseRadius>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
