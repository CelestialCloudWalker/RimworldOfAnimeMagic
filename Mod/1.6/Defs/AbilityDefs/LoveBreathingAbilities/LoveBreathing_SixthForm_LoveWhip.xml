        <rangeMultiplier>1.1</rangeMultiplier>
        <description>27 damage. Longer range. The whip line starts to glow with unmistakable love breathing color.</description>
        <cumulativeEffects>false</cumulativeEffects>
        <levelComps>
          <li Class="CompProperties_AbilityLaunchProjectile">
            <projectileDef>LoveBreathing_LoveWhip_Projectile_LThree</projectileDef>
