<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef>
    <defName>LoveBreathing_CatloveHazard_LOne</defName>
    <label>love zone</label>
    <description>A lingering trace of love breathing energy. Dangerous to stand in.</description>
    <thingClass>Verse.ThingWithComps</thingClass>
    <category>Ethereal</category>
    <useHitPoints>false</useHitPoints>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Animations/1024BLUR</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>3.5</drawSize>
      <color>(200, 255, 185)</color>
    </graphicData>
    <comps>
      <li Class="AnimeArsenal.CompProperties_GaleHazard">
        <durationTicks>120</durationTicks>
        <radius>2.0</radius>
        <damagePerTick>4</damagePerTick>
        <damageDef>Love_Breathing_Damage</damageDef>
        <armorPen>0.10</armorPen>
        <tickInterval>15</tickInterval>
        <onlyAffectHostiles>true</onlyAffectHostiles>
        <hazardEffecter>AnimeArsenal_WindHitK</hazardEffecter>
      </li>
    </comps>
  </ThingDef>

