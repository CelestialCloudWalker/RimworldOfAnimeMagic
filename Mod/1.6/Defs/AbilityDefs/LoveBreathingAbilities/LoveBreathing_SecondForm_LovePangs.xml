<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <EMF.LevelingResourceAbilityDef>
    <defName>LoveBreathing_SecondForm_LovePangs</defName>
    <label>Second Form: Love Pangs</label>
    <description>A single long, winding whip-swing that coils through the air and returns — slicing through everything nearby from every angle at once. There is no safe direction. Each cut arrives like a sudden pang: unexpected, piercing, inescapable.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>580</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayOrder>110</displayOrder>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>32</resourceCost>
    <baseExperienceGain>18</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>1</range>
      <warmupTime>0.55</warmupTime>
      <noiseRadius>3</noiseRadius>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_TwistAreaEffect">
        <baseDamage>20</baseDamage>
        <radius>5.5</radius>
        <maxTargets>10</maxTargets>
      </li>
      <li Class="AnimeArsenal.CompProperties_AbilityAoEBurst">
        <radius>5.5</radius>
        <damage>9</damage>
        <damageDef>Love_Breathing_Damage</damageDef>
        <armorPen>0.12</armorPen>
        <repeatCount>5</repeatCount>
        <damageInterval>6</damageInterval>
        <maxTargets>10</maxTargets>
        <onlyAffectHostiles>true</onlyAffectHostiles>
        <hitEffecter>AnimeArsenal_LoveHit</hitEffecter>
      </li>
    </comps>

    <levels>

      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>Whip sweeps around the caster for 20 damage, then cuts from 5 angles for 9 damage each (65 total). Applies Shivering Heart. Strong crowd control at close range.</description>
      </li>

      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>160</experienceRequired>
        <resourceCostMultiplier>1.15</resourceCostMultiplier>
        <description>Sweep hits for 25. Five cuts of 11 each (80 total). Reach extends slightly. Shivering Heart severity increases.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_TwistAreaEffect">
            <baseDamage>25</baseDamage>
            <radius>5.8</radius>
            <maxTargets>10</maxTargets>
          </li>
          <li Class="AnimeArsenal.CompProperties_AbilityAoEBurst">
            <radius>5.8</radius>
            <damage>11</damage>
            <damageDef>Love_Breathing_Damage</damageDef>
            <armorPen>0.14</armorPen>
