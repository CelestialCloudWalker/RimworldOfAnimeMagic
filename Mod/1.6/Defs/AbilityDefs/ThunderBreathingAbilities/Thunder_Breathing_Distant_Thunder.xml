<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <EMF.LevelingResourceAbilityDef>
    <defName>Thunder_Breathing_Distant_Thunder</defName>
    <label>Fourth Form: Distant Thunder</label>
    <description>Compresses breath energy into a bolt of concentrated lightning and launches it at the target. The strike arrives before the sound — like distant thunder heard long after the flash.</description>
    <iconPath>UI/Abilities/AbilityProjectile</iconPath>
    <cooldownTicksRange>60</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayOrder>200</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>20</resourceCost>
    <baseExperienceGain>10</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>20</range>
      <warmupTime>0.4</warmupTime>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>Thunder_Breath_Slice_Projectile</projectileDef>
      </li>
    </comps>
    <levels>
      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>Launches a lightning bolt at the target. Arrives before the thunder.</description>
      </li>
      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>100</experienceRequired>
        <resourceCostMultiplier>1.2</resourceCostMultiplier>
        <rangeMultiplier>1.2</rangeMultiplier>
        <cooldownMultiplier>0.9</cooldownMultiplier>
        <description>Faster bolt. Range extended. The thunder grows louder.</description>
        <levelComps>
          <li Class="CompProperties_AbilityLaunchProjectile">
            <projectileDef>Thunder_Breath_Slice_Projectile_LevelTwo</projectileDef>
          </li>
        </levelComps>
      </li>
      <li>
        <labelSuffix> (Level 3)</labelSuffix>
        <experienceRequired>250</experienceRequired>
        <resourceCostMultiplier>1.6</resourceCostMultiplier>
        <rangeMultiplier>1.3</rangeMultiplier>
        <cooldownMultiplier>0.85</cooldownMultiplier>
        <description>Heavier bolt with increased range and stopping power.</description>
        <levelComps>
          <li Class="CompProperties_AbilityLaunchProjectile">
            <projectileDef>Thunder_Breath_Slice_Projectile_LevelThree</projectileDef>
          </li>
        </levelComps>
      </li>
      <li>
        <labelSuffix> (Level 4)</labelSuffix>
        <experienceRequired>450</experienceRequired>
        <resourceCostMultiplier>2.0</resourceCostMultiplier>
        <rangeMultiplier>1.5</rangeMultiplier>
        <cooldownMultiplier>0.8</cooldownMultiplier>
        <description>Powerful bolt at extended range. Hits like a true lightning strike.</description>
        <levelComps>
          <li Class="CompProperties_AbilityLaunchProjectile">
            <projectileDef>Thunder_Breath_Slice_Projectile_LevelFour</projectileDef>
          </li>
        </levelComps>
      </li>
      <li>
        <labelSuffix> (Level 5)</labelSuffix>
        <experienceRequired>700</experienceRequired>
        <resourceCostMultiplier>2.0</resourceCostMultiplier>
        <rangeMultiplier>1.5</rangeMultiplier>
        <cooldownMultiplier>0.8</cooldownMultiplier>
        <description>Devastating bolt. The technique is near-perfect.</description>
        <levelComps>
          <li Class="CompProperties_AbilityLaunchProjectile">
            <projectileDef>Thunder_Breath_Slice_Projectile_LevelFive</projectileDef>
          </li>
        </levelComps>
      </li>
      <li>
        <labelSuffix> (Level 6)</labelSuffix>
        <experienceRequired>1050</experienceRequired>
        <resourceCostMultiplier>2.0</resourceCostMultiplier>
        <rangeMultiplier>1.5</rangeMultiplier>
        <cooldownMultiplier>0.8</cooldownMultiplier>
        <description>Perfected. A bolt of pure thunder breathing at maximum range. The target hears nothing — only the aftermath. Max Level.</description>
        <levelComps>
          <li Class="CompProperties_AbilityLaunchProjectile">
            <projectileDef>Thunder_Breath_Slice_Projectile_LevelSix</projectileDef>
          </li>
        </levelComps>
      </li>
    </levels>
  </EMF.LevelingResourceAbilityDef>
</Defs>
