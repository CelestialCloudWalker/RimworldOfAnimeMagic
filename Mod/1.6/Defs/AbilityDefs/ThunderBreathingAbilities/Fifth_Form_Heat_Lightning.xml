<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <EMF.LevelingResourceAbilityDef>
    <defName>Fifth_Form_Heat_Lightning</defName>
    <label>Fifth Form: Heat Lightning</label>
    <description>A defensive technique that channels the silent flash of heat lightning — the blade moves so fast it deflects all incoming projectiles before they can connect, like lightning that strikes before the storm arrives.</description>
    <iconPath>UI/Abilities/DeflectAbility</iconPath>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>30</resourceCost>
    <baseExperienceGain>8</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>-1</range>
    </verbProperties>
    <comps>
      <li Class="AnimeArsenal.CompProperties_DeflectProjectiles">
        <radius>3</radius>
        <TicksActive>600</TicksActive>
        <MaxShotsToReflect>10</MaxShotsToReflect>
        <effecterDef>AnimeArsenal_Deflect</effecterDef>
        <hediffDef>AnimeArsenal_DeflectionField</hediffDef>
      </li>
    </comps>
    <levels>
      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>The heat lightning guard deflects incoming fire. Reflects up to 10 shots.</description>
        <cumulativeEffects>false</cumulativeEffects>
      </li>
      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>100</experienceRequired>
        <resourceCostMultiplier>1.0</resourceCostMultiplier>
        <description>Wider deflection field. Reflects up to 13 shots.</description>
        <cumulativeEffects>false</cumulativeEffects>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_DeflectProjectiles">
            <radius>4</radius>
            <TicksActive>800</TicksActive>
