    <cooldownTicksRange>180</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayOrder>300</displayOrder>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>20</resourceCost>
    <baseExperienceGain>15</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>20</range>
      <warmupTime>0.4</warmupTime>
      <noiseRadius>3</noiseRadius>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_TeleportMeleeAttack">
        <damageAmount>7</damageAmount>
        <scaleStat>MeleeDamageFactor</scaleStat>
        <damageType>Mist_Breathing_Damage</damageType>
        <armorPenetration>0.25</armorPenetration>
        <additionalDamageFactorFromMeleeSkill>0.10</additionalDamageFactorFromMeleeSkill>
        <stunDuration>0</stunDuration>
        <effectRadius>0</effectRadius>
        <casterEffecter>AnimeArsenal_MistJump</casterEffecter>
        <impactEffecter>AnimeArsenal_MistHit</impactEffecter>
      </li>
      <li Class="AnimeArsenal.CompProperties_GiveHediff">
        <hediffDef>MistBreathing_Misdirection</hediffDef>
        <severityAdjustment>0.35</severityAdjustment>
        <applyToTarget>false</applyToTarget>
      </li>
    </comps>

    <levels>

