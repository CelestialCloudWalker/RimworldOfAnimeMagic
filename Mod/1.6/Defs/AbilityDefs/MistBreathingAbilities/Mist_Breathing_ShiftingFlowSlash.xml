          </li>
          <li Class="AnimeArsenal.CompProperties_GiveHediff">
            <hediffDef>MistBreathing_Misdirection</hediffDef>
            <severityAdjustment>0.36</severityAdjustment>
            <applyToTarget>false</applyToTarget>
