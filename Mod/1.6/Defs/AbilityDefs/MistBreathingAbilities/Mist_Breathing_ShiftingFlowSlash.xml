<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <EMF.LevelingResourceAbilityDef>
    <defName>Mist_Breathing_ShiftingFlowSlash</defName>
    <label>Mist Breathing: Shifting Flow Slash</label>
    <description>The user dissolves into the battlefield, flowing from enemy to enemy in a single continuous motion — each slash precise, each step dissolving into mist. With every target cut, their movements grow harder to read, leaving behind a deepening haze of misdirection.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>480</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayOrder>310</displayOrder>
    <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>28</resourceCost>
    <baseExperienceGain>20</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>16</range>
      <warmupTime>0.45</warmupTime>
      <noiseRadius>3</noiseRadius>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_BaseStance">
        <maxJumps>3</maxJumps>
        <ticksBetweenJumps>5</ticksBetweenJumps>
        <jumpDistance>6</jumpDistance>
        <targetSearchRadius>10</targetSearchRadius>
        <jumpDamageDef>Mist_Breathing_Damage</jumpDamageDef>
        <jumpDamage>5~7</jumpDamage>
        <scaleStat>MeleeDamageFactor</scaleStat>
        <debugScaling>true</debugScaling>
        <casterEffecter>AnimeArsenal_MistJump</casterEffecter>
        <impactEffecter>AnimeArsenal_MistHit</impactEffecter>
      </li>
      <li Class="AnimeArsenal.CompProperties_GiveHediff">
        <hediffDef>MistBreathing_Misdirection</hediffDef>
        <severityAdjustment>0.28</severityAdjustment>
        <applyToTarget>false</applyToTarget>
      </li>
    </comps>

    <levels>

      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>5~7 damage per slash. Flows through up to 3 targets. Grants Misdirection on use — stacks with existing haze.</description>
      </li>

      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>140</experienceRequired>
        <resourceCostMultiplier>1.15</resourceCostMultiplier>
        <description>6~9 damage. Adds a 4th target. Misdirection gain increased — reliably reaches Low Clouds on a full flow.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_BaseStance">
            <maxJumps>4</maxJumps>
