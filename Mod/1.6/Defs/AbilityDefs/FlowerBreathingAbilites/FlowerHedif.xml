<Defs>

  <HediffDef>
    <defName>FlowerBreathing_VermilionEye_L1</defName>
    <label>Vermilion Eye</label>
    <description>Kinetic vision elevated to its peak. The sclera reddens. The world slows to a crawl — every attack telegraphed, every opening visible. The eyes are paying a price for this clarity.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.10, 0.10)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>480</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>vermilion eye</label>
        <minSeverity>0.0</minSeverity>
        <statOffsets>
          <MeleeHitChance>0.22</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <MeleeDodgeChance>1.40</MeleeDodgeChance>
          <ShootingAccuracyPawn>1.30</ShootingAccuracyPawn>
          <AimingDelayFactor>0.65</AimingDelayFactor>
          <MeleeCooldownFactor>0.82</MeleeCooldownFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

