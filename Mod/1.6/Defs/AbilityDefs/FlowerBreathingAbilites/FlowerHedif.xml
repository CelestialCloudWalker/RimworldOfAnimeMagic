  <HediffDef>
    <defName>FlowerBreathing_EyeStrain</defName>
    <label>eye strain</label>
    <description>The blood vessels behind the eyes are slowly tearing from repeated overuse of Vermilion Eye. Vision flickers at the edges. Something is building up that cannot be undone.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.80, 0.15, 0.15)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="AnimeArsenal.HediffCompProperties_BlindEyeAtThreshold">
        <severityThreshold>0.95</severityThreshold>
        <hediffDef>FlowerBreathing_BlindedEye</hediffDef>
      </li>
    </comps>
    <stages>
      <li>
        <label>mild strain</label>
        <minSeverity>0.0</minSeverity>
      </li>
      <li>
        <label>vessel stress</label>
        <minSeverity>0.30</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>-0.04</ShootingAccuracyPawn>
          <MeleeHitChance>-0.03</MeleeHitChance>
        </statOffsets>
      </li>
      <li>
        <label>blood vessel damage</label>
        <minSeverity>0.55</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>-0.10</ShootingAccuracyPawn>
          <MeleeHitChance>-0.08</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <MeleeDodgeChance>0.90</MeleeDodgeChance>
        </statFactors>
      </li>
      <li>
        <label>critical rupture</label>
        <minSeverity>0.80</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>-0.20</ShootingAccuracyPawn>
          <MeleeHitChance>-0.16</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <MeleeDodgeChance>0.78</MeleeDodgeChance>
        </statFactors>
        <vomitMtbDays>999</vomitMtbDays>
      </li>
      <li>
        <label>rupture — sight failing</label>
        <minSeverity>0.95</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>-0.30</ShootingAccuracyPawn>
          <MeleeHitChance>-0.24</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <MeleeDodgeChance>0.65</MeleeDodgeChance>
        </statFactors>
      </li>
    </stages>
  </HediffDef>


  <HediffDef>
    <defName>FlowerBreathing_BlindedEye</defName>
    <label>ruptured eye vessels</label>
    <description>The blood vessels behind one eye burst completely from the strain of the Vermilion Eye technique. The eye is permanently damaged. Sight in that eye is gone.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75, 0.10, 0.10)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <label>permanently blinded</label>
        <minSeverity>0.0</minSeverity>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
