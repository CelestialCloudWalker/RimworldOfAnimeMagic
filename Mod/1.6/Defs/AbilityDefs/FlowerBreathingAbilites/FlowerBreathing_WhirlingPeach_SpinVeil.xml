<Defs>


  <HediffDef>
    <defName>FlowerBreathing_WhirlingPeach_SpinVeil_L1</defName>
    <label>Whirling Peach (spinning)</label>
    <description>Pivoting through an evasive spin — the body's rotation makes incoming strikes hard to land.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.60, 0.75)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>spinning</label>
        <minSeverity>0.0</minSeverity>
        <statFactors>
          <MeleeDodgeChance>1.30</MeleeDodgeChance>
          <MeleeCooldownFactor>0.88</MeleeCooldownFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

