<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>WaterBreathing_FlowLikeWater</defName>
    <label>flow like water</label>
    <labelNoun>flow like water</labelNoun>
    <description>The pawn moves with the fluid grace of water breathing technique. Pain is dulled, senses are heightened, and attacks seem easier to read and avoid.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 0.7, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.25</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>weak flow</label>
        <minSeverity>0.0</minSeverity>
        <statOffsets>
          <MeleeDodgeChance>0.03</MeleeDodgeChance>
        </statOffsets>
      </li>
      <li>
        <label>flowing</label>
        <minSeverity>0.25</minSeverity>
        <statOffsets>
          <MeleeDodgeChance>0.08</MeleeDodgeChance>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>strong flow</label>
        <minSeverity>0.5</minSeverity>
        <statOffsets>
          <MeleeDodgeChance>0.14</MeleeDodgeChance>
          <MoveSpeed>0.15</MoveSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.08</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>turbulent flow</label>
        <minSeverity>0.75</minSeverity>
        <statOffsets>
          <MeleeDodgeChance>0.22</MeleeDodgeChance>
          <MoveSpeed>0.30</MoveSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.12</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.10</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>


  <HediffDef>
    <defName>WaterBreathing_DeadCalm</defName>
    <label>dead calm</label>
    <labelNoun>dead calm</labelNoun>
    <description>The pawn stands perfectly still. Incoming projectiles are deflected. Enemies who approach are cut by resonating sword pressure.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.9, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="AnimeArsenal.CompProperties_AuraPulseHediff">
        <intervalTicks>60</intervalTicks>
        <radius>6</radius>
        <damagePerPulse>8</damagePerPulse>
        <damageDef>Water_Breathing_Damage</damageDef>
        <armorPen>0.1</armorPen>
        <pulseEffecter>AnimeArsenal_WaterHit</pulseEffecter>
        <affectAllies>false</affectAllies>
        <affectNeutrals>false</affectNeutrals>
        <affectDowned>true</affectDowned>
        <affectSummoner>false</affectSummoner>
      </li>
      <li Class="AnimeArsenal.CompProperties_DeflectProjectilesPassive">
        <radius>5</radius>
        <maxShotsBeforeReset>999</maxShotsBeforeReset>
      </li>
    </comps>
    <stages>
      <li>
        <label>dead calm</label>
        <minSeverity>0.0</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.20</setMax>
          </li>
        </capMods>
        <statOffsets>
          <MeleeDodgeChance>0.40</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
