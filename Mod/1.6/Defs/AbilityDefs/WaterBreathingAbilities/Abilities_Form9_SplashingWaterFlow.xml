<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <EMF.LevelingResourceAbilityDef>
    <defName>Water_Breathing_SplashingWaterFlow</defName>
    <label>Water Breathing: Splashing Water Flow, Turbulent</label>
    <category>WaterBreathing_Ability_Catergory</category>
    <description>The user flows like turbulent water — movement speed surges and "Flow Like Water" is enhanced far beyond what Flowing Dance can achieve, reaching its peak intensity.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayOrder>280</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>50</resourceCost>
    <baseExperienceGain>30</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>1</range>
      <warmupTime>0.3</warmupTime>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_GiveHediff">
        <hediffDef>WaterBreathing_FlowLikeWater</hediffDef>
        <severityAdjustment>0.75</severityAdjustment>
        <applyToTarget>false</applyToTarget>
      </li>
    </comps>

    <levels>
      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>Greatly boosts movement speed and raises Flow Like Water to turbulent intensity.</description>
      </li>
      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>250</experienceRequired>
        <cooldownMultiplier>0.9</cooldownMultiplier>
        <description>The flow comes faster, and lasts longer.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_GiveHediff">
            <hediffDef>WaterBreathing_FlowLikeWater</hediffDef>
            <severityAdjustment>0.85</severityAdjustment>
            <applyToTarget>false</applyToTarget>
          </li>
        </levelComps>
      </li>
      <li>
        <labelSuffix> (Level 3)</labelSuffix>
        <experienceRequired>550</experienceRequired>
        <cooldownMultiplier>0.85</cooldownMultiplier>
        <description>Perfected. Instantly enters peak turbulent flow. Max Level.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_GiveHediff">
            <hediffDef>WaterBreathing_FlowLikeWater</hediffDef>
            <severityAdjustment>1.0</severityAdjustment>
            <applyToTarget>false</applyToTarget>
          </li>
        </levelComps>
      </li>
    </levels>
  </EMF.LevelingResourceAbilityDef>

</Defs>
