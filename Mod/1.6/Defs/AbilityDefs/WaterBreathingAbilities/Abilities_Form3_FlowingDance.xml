<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <EMF.LevelingResourceAbilityDef>
    <defName>Water_Breathing_FlowingDance</defName>
    <label>Water Breathing: Flowing Dance</label>
    <category>WaterBreathing_Ability_Catergory</category>
    <description>A fluid multi-target technique. The user dances between enemies, delivering a sequence of precise cuts. Grants "Flow Like Water", improving the user's pain tolerance and melee evasion.</description>
    <iconPath>UI/Icons/ComingSoon</iconPath>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <targetRequired>true</targetRequired>
    <hostile>true</hostile>
    <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
    <displayOrder>220</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <resourceDef>BreathingPotential_Resource</resourceDef>
    <resourceCost>40</resourceCost>
    <baseExperienceGain>25</baseExperienceGain>
    <showExperienceInTooltip>true</showExperienceInTooltip>

    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>12</range>
      <warmupTime>0.8</warmupTime>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>

    <comps>
      <li Class="AnimeArsenal.CompProperties_BaseStance">
        <maxJumps>4</maxJumps>
        <ticksBetweenJumps>4</ticksBetweenJumps>
        <jumpDistance>5</jumpDistance>
        <targetSearchRadius>12</targetSearchRadius>
        <jumpDamageDef>Water_Breathing_Damage</jumpDamageDef>
        <jumpDamage>4~5</jumpDamage>
        <scaleStat>MeleeDamageFactor</scaleStat>
        <debugScaling>true</debugScaling>
        <casterEffecter>AnimeArsenal_WaterJump</casterEffecter>
        <impactEffecter>AnimeArsenal_WaterHit</impactEffecter>
      </li>
      <li Class="AnimeArsenal.CompProperties_GiveHediff">
        <hediffDef>WaterBreathing_FlowLikeWater</hediffDef>
        <severityAdjustment>0.25</severityAdjustment>
        <applyToTarget>false</applyToTarget>
      </li>
    </comps>

    <levels>
      <li>
        <labelSuffix> (Level 1)</labelSuffix>
        <experienceRequired>0</experienceRequired>
        <description>Dashes to up to 4 enemies, cutting each on landing. Grants Flow Like Water.</description>
      </li>
      <li>
        <labelSuffix> (Level 2)</labelSuffix>
        <experienceRequired>150</experienceRequired>
        <rangeMultiplier>1.15</rangeMultiplier>
        <cooldownMultiplier>0.95</cooldownMultiplier>
        <description>5 jumps, slightly more damage per hit. Wider search radius.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_BaseStance">
            <maxJumps>5</maxJumps>
            <ticksBetweenJumps>3</ticksBetweenJumps>
            <jumpDistance>5</jumpDistance>
            <targetSearchRadius>14</targetSearchRadius>
            <jumpDamageDef>Water_Breathing_Damage</jumpDamageDef>
            <jumpDamage>5~7</jumpDamage>
            <scaleStat>MeleeDamageFactor</scaleStat>
            <debugScaling>true</debugScaling>
            <casterEffecter>AnimeArsenal_WaterJump</casterEffecter>
            <impactEffecter>AnimeArsenal_WaterHit</impactEffecter>
          </li>
          <li Class="AnimeArsenal.CompProperties_GiveHediff">
            <hediffDef>WaterBreathing_FlowLikeWater</hediffDef>
            <severityAdjustment>0.30</severityAdjustment>
            <applyToTarget>false</applyToTarget>
          </li>
        </levelComps>
      </li>
      <li>
        <labelSuffix> (Level 3)</labelSuffix>
        <experienceRequired>350</experienceRequired>
        <rangeMultiplier>1.25</rangeMultiplier>
        <cooldownMultiplier>0.9</cooldownMultiplier>
        <description>6 jumps, faster between cuts, greater reach.</description>
        <levelComps>
          <li Class="AnimeArsenal.CompProperties_BaseStance">
            <maxJumps>6</maxJumps>
            <ticksBetweenJumps>3</ticksBetweenJumps>
            <jumpDistance>6</jumpDistance>
            <targetSearchRadius>17</targetSearchRadius>
            <jumpDamageDef>Water_Breathing_Damage</jumpDamageDef>
            <jumpDamage>6~9</jumpDamage>
            <scaleStat>MeleeDamageFactor</scaleStat>
            <debugScaling>true</debugScaling>
            <casterEffecter>AnimeArsenal_WaterJump</casterEffecter>
            <impactEffecter>AnimeArsenal_WaterHit</impactEffecter>
          </li>
          <li Class="AnimeArsenal.CompProperties_GiveHediff">
            <hediffDef>WaterBreathing_FlowLikeWater</hediffDef>
            <severityAdjustment>0.35</severityAdjustment>
            <applyToTarget>false</applyToTarget>
