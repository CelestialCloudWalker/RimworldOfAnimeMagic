    <label>explosive rush (charging)</label>
    <description>Barreling forward at blinding speed — incoming fire glances off before it can land.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.85, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1.0</initialSeverity>
