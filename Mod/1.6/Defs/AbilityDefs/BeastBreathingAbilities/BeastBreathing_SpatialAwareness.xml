<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <HediffDef>
    <defName>BeastBreathing_SpatialAwareness_LOne</defName>
    <hediffClass>AnimeArsenal.Hediff_TransparentWorld</hediffClass>
    <label>spatial awareness (Level 1)</label>
    <description>A faint hum of the air across outstretched palms. Enemies nearby register as subtle pressure shifts — their positions felt rather than seen. Combat instincts sharpen just enough to act a half-step ahead.</description>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
          <MeleeHitChance>0.12</MeleeHitChance>
          <MoveSpeed>0.2</MoveSpeed>
          <AimingDelayFactor>-0.10</AimingDelayFactor>
          <MeleeDodgeChance>0.12</MeleeDodgeChance>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>0.08</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.05</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <modExtensions>
      <li Class="AnimeArsenal.TransparentWorldProperties">
        <sightRange>14</sightRange>
        <durationTicks>2200</durationTicks>
        <organHitChanceBonus>0.4</organHitChanceBonus>
        <vitalOrganChanceMultiplier>1.08</vitalOrganChanceMultiplier>
      </li>
    </modExtensions>
  </HediffDef>

