        <TicksActive>700</TicksActive>
        <MaxShotsToReflect>12</MaxShotsToReflect>
        <effecterDef>AnimeArsenal_BeastReflect</effecterDef>
        <hediffDef>AnimeArsenal_DeflectionField</hediffDef>
      </li>
    </comps>

